# @wigtn 스코프는 GitHub Packages에서 온다.
#
# 이 저장소는 공개지만 여기서 쓰는 코어 모듈(ui-kit, content-engine,
# backoffice-frame)은 비공개 패키지다. 설치하려면 `read:packages` 권한이 있는
# 토큰이 NODE_AUTH_TOKEN으로 있어야 한다.
#
# 토큰 값은 저장소에 적지 않는다. 로컬에서는 환경변수로, CI와 Vercel에서는
# 각 환경의 비밀 값으로 넣는다.
#
#   export NODE_AUTH_TOKEN=<read:packages 권한 토큰>
#   npm install
#
# 토큰이 없으면 설치가 401로 멈춘다. 조용히 건너뛰지 않는 편이 낫다.
# 무엇이 없어서 안 되는지 모른 채 빌드가 깨지는 게 더 나쁘다.
@wigtn:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
