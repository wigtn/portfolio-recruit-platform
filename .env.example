# ── 상담 접수 채널 (둘 중 하나 이상. 미설정 시 API는 성공으로 위장하지 않고 503) ──
# 1순위: Resend로 contact@wigtn.com 직접 발송. 키 값은 저장소·로그에 절대 기록하지 않는다.
WIGTN_RESEND_API_KEY=
# 발신 주소 — wigtn.com 도메인을 Resend에 검증한 뒤 no-reply@wigtn.com 형태로 교체.
# 미설정 시 Resend 테스트 발신자(onboarding@resend.dev)를 쓰며, 이 경우 Resend 계정
# 소유자의 주소로만 수신된다(도메인 검증 전 제약).
CONTACT_FROM=
# 2순위(또는 이메일 실패 폴백): 웹훅
CONTACT_WEBHOOK_URL=
CONTACT_TO=contact@wigtn.com
# ── AI 참고 답변·상담 챗봇 실생성 (선택) ──
# 설정 시 글 상세의 AI 답변과 상담 챗봇이 실제 OpenAI 스트리밍으로 동작합니다(gpt-5.6-luna).
# 미설정 시 시드 초안·스크립트 답변 연출로 동작 — 데모는 키 없이도 완결됩니다.
# 상한: 챗봇 IP·세션당 시간당 20 · 전체 일 300 / AI답변 IP당 시간당 10 · 일 200.
WIGTN_OPENAI_API_KEY=
# ── 익명 방문자 rate limit 쿠키 서명 (선택) ──
# 설정 시 챗봇이 서명된 익명 세션 쿠키(wigtn_anon)를 발급해 IP와 함께 이중으로 셉니다.
# 미설정 시 쿠키 축을 접고 IP 축만으로 동작합니다(에러 아님, 기능만 축소).
# 아무 긴 무작위 문자열이면 됩니다: openssl rand -base64 32
WIGTN_COOKIE_SECRET=
